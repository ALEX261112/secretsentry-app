# Copie ce fichier en .env et remplis les valeurs.

# Optionnel mais recommandé : un token GitHub (classic, sans scope particulier
# suffit pour la recherche publique) augmente la limite de l'API Code Search
# de 10 à 30 requêtes/minute. Crée-en un sur https://github.com/settings/tokens
GITHUB_TOKEN=

# Port d'écoute du backend
PORT=8787

# Origine autorisée en CORS (mets l'URL de ta web app en prod, * en dev)
ALLOWED_ORIGIN=*
